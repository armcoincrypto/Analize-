# Analize Configuration
# Copy this file to .env and update values

# =============================================================================
# Application
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
GIT_COMMIT_HASH=
STRATEGY_VERSION=v1.0.0

# =============================================================================
# HFT Bot
# =============================================================================
# Smoke-test mode: 0=production (default), 1=enable diagnostic test trades
SMOKE_TEST=0
# Adaptive minimum take-profit (Deliverable 4)
BASE_MIN_PROFIT_PCT=0.08
COST_MULTIPLIER=1.0
COST_BUFFER_PCT=0.03

# =============================================================================
# Database
# =============================================================================
# Primary database (Postgres for metadata)
DB_POSTGRES_URL=postgresql://analize:analize@localhost:5432/analize

# ScalperBot database (SQLite or Postgres)
DB_SCALPERBOT_DB_URL=sqlite:///data/scalperbot.db

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# =============================================================================
# Storage
# =============================================================================
# S3-compatible storage (optional)
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=analize-data
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_REGION=us-east-1

# Local storage
STORAGE_LOCAL_DATA_PATH=./data
STORAGE_RAW_DATA_PATH=./data/raw
STORAGE_PROCESSED_DATA_PATH=./data/processed
STORAGE_REPORTS_PATH=./data/reports

# Retention (days)
STORAGE_RAW_DATA_RETENTION_DAYS=180
STORAGE_PARQUET_RETENTION_DAYS=730

# =============================================================================
# API
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_DEBUG=false
API_CORS_ORIGINS=["*"]

# Rate limiting
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW=60

# =============================================================================
# Analysis
# =============================================================================
ANALYSIS_DEFAULT_SYMBOLS=["BTCUSDT", "ETHUSDT"]
ANALYSIS_TIMEFRAMES=["1m", "5m", "15m", "1h", "4h"]
ANALYSIS_OUTCOME_WINDOWS=[1, 5, 15, 60, 240]
ANALYSIS_OPTIMIZATION_OBJECTIVE=profit_factor
ANALYSIS_OPTIMIZATION_TOP_N=5
ANALYSIS_OPTIMIZATION_MIN_TRADES=30
ANALYSIS_DEFAULT_SLIPPAGE_BPS=5.0
ANALYSIS_DEFAULT_COMMISSION_BPS=10.0

# Walk-forward
ANALYSIS_WALK_FORWARD_TRAIN_DAYS=30
ANALYSIS_WALK_FORWARD_TEST_DAYS=7

# =============================================================================
# Notifications
# =============================================================================
# Telegram
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# Slack
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_SLACK_CHANNEL=#analize-alerts

# Email
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=analize@localhost
NOTIFY_EMAIL_TO=[]

# =============================================================================
# Scheduler
# =============================================================================
SCHEDULER_INGEST_CRON=*/5 * * * *
SCHEDULER_DAILY_ANALYSIS_CRON=0 1 * * *
SCHEDULER_WEEKLY_ANALYSIS_CRON=0 2 * * 0
SCHEDULER_OPTIMIZATION_CRON=0 3 * * *
SCHEDULER_DAILY_REPORT_CRON=0 6 * * *
SCHEDULER_WEEKLY_REPORT_CRON=0 7 * * 1
